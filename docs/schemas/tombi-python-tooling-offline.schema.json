{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "KubernetesLens tool-only automation configuration",
  "description": "Offline structural schema for the exact local Ruff/ty configuration shape. The shared locked tools remain authoritative semantic validators. No local Python dependency inventory is permitted.",
  "type": "object",
  "required": ["tool"],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "object",
      "required": ["ruff", "ty"],
      "additionalProperties": false,
      "properties": {
        "ruff": {
          "type": "object",
          "required": ["target-version", "line-length", "include", "lint"],
          "additionalProperties": false,
          "properties": {
            "target-version": {
              "const": "py313",
              "type": "string"
            },
            "line-length": {
              "const": 100,
              "type": "integer"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lint": {
              "type": "object",
              "required": ["select"],
              "additionalProperties": false,
              "properties": {
                "select": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["E", "F", "I", "UP", "B", "ANN", "RUF"],
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "ty": {
          "type": "object",
          "required": ["environment", "src", "terminal"],
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "object",
              "required": ["python-version"],
              "additionalProperties": false,
              "properties": {
                "python-version": {
                  "const": "3.13",
                  "type": "string"
                }
              }
            },
            "src": {
              "type": "object",
              "required": ["include"],
              "additionalProperties": false,
              "properties": {
                "include": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "terminal": {
              "type": "object",
              "required": ["error-on-warning"],
              "additionalProperties": false,
              "properties": {
                "error-on-warning": {
                  "const": true,
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
