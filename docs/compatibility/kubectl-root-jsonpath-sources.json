  "contracts": {
    "selection": "Ordinary JSONPath current-object token selects the complete root without field projection, range, or results-array wrapper.",
    "unstructured": "Create uses unstructured request/response objects; the printer uses UnstructuredContent directly, retaining the available returned map and nested JSON value types.",
    "typed_fallback": "Other typed runtime objects use a marshal/unmarshal fallback; no arbitrary typed-object numeric precision guarantee is inferred.",
    "serialization": "Root map PrintResults uses JSON marshaling, not scalar stringification; whitespace, escaping representation, key order, and final newline may differ.",
    "type_setter": "Both original JSON and JSONPath routes use the same TypeSetter; its source is identical in these releases.",
    "modern_difference": "Modern JSON defaults omit managedFields through a deep-copy wrapper; ordinary JSONPath retains them. This can increase modern output size.",
    "validation": "The existing four exact string identity checks and all failure/capture limits remain unchanged.",
    "qualification": "Source compatibility only; neither native/runtime acceptance nor actual response fit within 4096 bytes is established."
