{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["cargo", "github-actions", "rust-toolchain", "custom.regex"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Berlin",
  "ignorePaths": [
    "**/node_modules/**",
    "**/target/**",
    "**/fixtures/**",
    "**/tests/**",
    "docs/evidence/**",
    "**/.shared-tools/**",
    "**/.validation-base/**",
    "docs/compatibility/**",
    "schemas/capabilities/**"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Track immutable shared tool and policy revisions; upstream owns its entire pin inventory"
      ],
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)# renovate: datasource=github-digest depName=(?<depName>Strukturpiloten/(?:boxferry|\\.github)) currentValue=(?<currentValue>main)\\n[ \\t]*ref:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "versioningTemplate": "git",
      "autoReplaceStringTemplate": "{{{indentation}}}# renovate: datasource=github-digest depName={{{depName}}} currentValue={{{newValue}}}\n{{{indentation}}}ref: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": [
        "Update the immutable official Renovate operational-test image as one version/digest pair"
      ],
      "managerFilePatterns": ["/^scripts/renovate-tool\\.json$/"],
      "matchStrings": [
        "\"image\":\\s*\"(?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "\"image\": \"{{{depName}}}:{{{newValue}}}@{{{newDigest}}}\""
    },
    {
      "customType": "regex",
      "description": [
        "One owned rootful-kind Fedora CoreOS QEMU base image; exact operational path only"
      ],
      "managerFilePatterns": ["/^scripts/kind-vm-image\\.json$/"],
      "matchStrings": [
        "^\\s*\\{\\s*\"schema\":\\s*\"kubernetes-lens-owned-vm-image-v1\",\\s*\"release\":\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)\",\\s*\"archive_sha256\":\\s*\"(?<currentDigest>[a-f0-9]{64})\"\\s*\\}\\s*$"
      ],
      "depNameTemplate": "fedora-coreos-qemu-x86_64-stable",
      "datasourceTemplate": "custom.fcos-qemu-x86_64-stable",
      "versioningTemplate": "regex:^(?<major>[0-9]+)\\.(?<minor>[0-9]+)\\.(?<patch>[0-9]+)\\.(?<build>[0-9]+)$",
      "autoReplaceStringTemplate": "{\n  \"schema\": \"kubernetes-lens-owned-vm-image-v1\",\n  \"release\": \"{{{newValue}}}\",\n  \"archive_sha256\": \"{{{newDigest}}}\"\n}"
    }
  ],
  "packageRules": [
    {
      "description": ["Group compatible Rust updates"],
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "Rust dependencies"
    },
    {
      "description": ["Keep Actions immutable and grouped"],
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "pinDigests": true,
      "groupName": "GitHub Actions"
    },
    {
      "description": ["Automerge tested compatible updates only after required CI"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": ["Lock maintenance has no new release-age comparison"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": ["Review toolchain changes separately"],
      "matchManagers": ["rust-toolchain"],
      "groupName": "Rust toolchain",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": [
        "Review shared checksum/image/feature ownership and policy changes after generic rules"
      ],
      "matchDatasources": ["github-digest"],
      "groupName": "Shared workspace tooling and policy",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": ["Review hosted runner environment changes"],
      "matchDatasources": ["github-runners"],
      "groupName": "GitHub-hosted runners",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": [
        "Node runtime comes from the reviewed shared inventory, not a second local version pin"
      ],
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["actions/node-versions"],
      "enabled": false
    },
    {
      "description": [
        "Review operational tool-image tag/digest and actual-engine evidence after generic automerge rules"
      ],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "groupName": "Operational test tools",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "pinDigests": true
    },
    {
      "description": [
        "Review bundled native timezone data after generic automerge rules; recognition is versioned evidence"
      ],
      "matchManagers": ["cargo"],
      "matchPackageNames": ["jiff-tzdb"],
      "groupName": "Native timezone data",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": [
        "Review native binary codec integrity and padding semantics after generic automerge rules"
      ],
      "matchManagers": ["cargo"],
      "matchPackageNames": ["base64"],
      "groupName": "Native binary codecs",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": [
        "Review supervised renderer isolation, descriptor and digest dependencies after generic automerge rules"
      ],
      "matchManagers": ["cargo"],
      "matchPackageNames": ["nix", "rustix", "command-fds", "close_fds", "sha2"],
      "groupName": "Supervised renderer dependencies",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": [
        "Review owned VM image version/digest together after generic automerge; stream provides no publication timestamp so promotion remains manual"
      ],
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["custom.fcos-qemu-x86_64-stable"],
      "matchPackageNames": ["fedora-coreos-qemu-x86_64-stable"],
      "groupName": "Owned kind VM image",
      "dependencyDashboardApproval": true,
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-required"
    }
  ],
  "customDatasources": {
    "fcos-qemu-x86_64-stable": {
      "defaultRegistryUrlTemplate": "https://builds.coreos.fedoraproject.org/streams/stable.json",
      "format": "json",
      "transformTemplates": [
        "($a := architectures.x86_64.artifacts.qemu; $d := $a.formats.\"qcow2.xz\".disk; {\"releases\": stream = \"stable\" and $type($a.release) = \"string\" and $type($d.sha256) = \"string\" and $exists($match($a.release, /^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$/)) and $exists($match($d.sha256, /^[a-f0-9]{64}$/)) ? [{\"version\": $a.release, \"digest\": $d.sha256}] : []})"
      ]
    }
  }
}
